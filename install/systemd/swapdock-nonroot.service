[Unit]
Description=swapdock deploy API (non-root, broker-backed)
After=network-online.target docker.service swapdock-broker.service
Wants=network-online.target
Requires=swapdock-broker.service

[Service]
Type=simple
User=@INSTALL_USER@
Group=@INSTALL_USER@
SupplementaryGroups=adm
EnvironmentFile=-/etc/swapdock/api.env
Environment=SWAPDOCK_BROKER_SOCKET=/run/swapdock/broker.sock
ExecStart=/usr/local/bin/swapdock serve \
  --bind 127.0.0.1:8088 \
  --registry /srv/swapdock/apps \
  --trace /var/log/swapdock/swapdock.jsonl \
  --state-dir /srv/swapdock/green \
  --lock-dir /srv/swapdock/locks
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/srv/swapdock /var/log/swapdock
UMask=0027

[Install]
WantedBy=multi-user.target
