[Unit]
Description=swapdock scheduled app backups
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Runs every configured [backup] command; a failed app is reported on stderr and
# in the run log. It is not a substitute for a tested restore.
ExecStart=/usr/local/bin/swapdock backup --all
User=root
EnvironmentFile=-/etc/swapdock/api.env
RuntimeDirectory=swapdock
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/srv/swapdock /var/log/swapdock
UMask=0027
Nice=10
IOSchedulingClass=idle
