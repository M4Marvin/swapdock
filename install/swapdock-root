#!/bin/sh
# Narrow root entry point for the root-mode install. The install user may run
# normal deploy/maintenance subcommands, but not the broker server, `serve`, or
# path-override flags that would turn the binary into an arbitrary root exec.
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "swapdock-root: must run as root (use the sudoers entry)" >&2
    exit 1
fi

case "${1:-}" in
    serve|broker)
        echo "swapdock-root: '$1' is not available through the install-user entry point" >&2
        exit 1
        ;;
esac

for arg in "$@"; do
    case "$arg" in
        --nginx-bin|--nginx-bin=*|--docker-bin|--docker-bin=*|--main-config|--main-config=*|--target|--target=*|--pid-file|--pid-file=*|--socket|--socket=*|--bind|--bind=*|--tls-cert|--tls-cert=*|--tls-key|--tls-key=*|--allow-unauthenticated)
            echo "swapdock-root: '$arg' is not allowed through the install-user entry point" >&2
            exit 1
            ;;
    esac
done

exec /usr/local/bin/swapdock "$@"
